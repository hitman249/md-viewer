# Сборка Tauri-приложения в изолированном окружении с системными зависимостями.
FROM node:22

# Системные зависимости, требуемые для сборки Tauri (webkit/gtk/cairo и др.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libwebkit2gtk-4.1-dev \
    libgtk-3-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    build-essential \
    libssl-dev \
    libcairo2-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем свежий stable-тулчейн Rust через rustup
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable

ENV PATH="/root/.cargo/bin:${PATH}"
WORKDIR /app
